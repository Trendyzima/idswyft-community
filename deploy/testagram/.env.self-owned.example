# Testagram self-owned identity verification
# Copy to .env on the verification host and chmod 600.

DB_NAME=testagram_identity
DB_USER=testagram_identity
DB_PASSWORD=REPLACE_WITH_64_HEX_RANDOM_BYTES

JWT_SECRET=REPLACE_WITH_64_HEX_RANDOM_BYTES
API_KEY_SECRET=REPLACE_WITH_64_HEX_RANDOM_BYTES
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_RANDOM_BYTES
SERVICE_TOKEN=REPLACE_WITH_64_HEX_RANDOM_BYTES

DOMAIN=verify.testagram.site
CORS_ORIGINS=https://verify.testagram.site
IDSWYFT_PORT=8080

STORAGE_PROVIDER=local
SANDBOX_MODE=false
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Optional during builds only if a private model release asset is required.
# GITHUB_TOKEN=
